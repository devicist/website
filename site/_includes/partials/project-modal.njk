{% from "partials/section-header.njk" import sectionHeader %}
{% from "partials/video-embed.njk" import videoEmbed %}
{% from "partials/gallery.njk" import gallery %}

{% macro projectModal(id, title, body, videoUrl, images) %}
<div class="project-modal" id="{{ id }}" role="dialog" aria-modal="true" aria-label="{{ title }}">
  <div class="project-modal-overlay projectOverlay"></div>
  <div class="project-modal-container">
    <div class="project-modal-inner projectModal">
      <button type="button" class="project-modal-close" aria-label="Close">
        <svg fill="#FFFFFF" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24px" height="24px" class="modal-close-icon">
          <path d="M 4.7070312 3.2929688 L 3.2929688 4.7070312 L 10.585938 12 L 3.2929688 19.292969 L 4.7070312 20.707031 L 12 13.414062 L 19.292969 20.707031 L 20.707031 19.292969 L 13.414062 12 L 20.707031 4.7070312 L 19.292969 3.2929688 L 12 10.585938 L 4.7070312 3.2929688 z" />
        </svg>
      </button>
      <div class="project-modal-content" tabindex="-1">
        <section>
          <div class="container">
            {{ sectionHeader(title, body, "h2", null, "center-content mt-32") }}
            <div class="projectVideo">
              {{ videoEmbed(videoUrl) }}
            </div>
            <div class="gridWrapper">
              {{ gallery(images, 100, true) }}
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
{% endmacro %}
