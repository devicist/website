{
  "name": "website",
  "version": "0.1.0",
  "homepage": "https://devicist.com",
  "private": true,
  "scripts": {
    "css:build": "sass site/css/style.scss _site/css/style.css --load-path=node_modules",
    "build": "npm run css:build && eleventy",
    "start": "npm run css:build && eleventy --serve",
    "deploy": "npm run build && gh-pages -d _site -r https://github.com/devicist/devicist.github.io.git -b main"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devicist/website/"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "bootstrap": "^4.6.0",
    "gh-pages": "^4.0.0",
    "sass": "^1.49.7"
  }
}
